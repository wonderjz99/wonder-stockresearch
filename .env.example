# 本地凭据与配置示例。
# 复制为项目根目录的 .env 并填入你自己的值；.env 已被 .gitignore 忽略，不会提交。
# 已存在的环境变量优先，.env 不会覆盖它们。

# DeepSeek 写作入口（write-draft）所需
DEEPSEEK_API_KEY=

# 可选：DeepSeek 参数
# WONDER_DEEPSEEK_MODEL=deepseek-flash
# WONDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# WONDER_DEEPSEEK_MAX_TOKENS=16000
# WONDER_DEEPSEEK_THINKING=disabled        # disabled/enabled；默认 disabled（temperature 仅在 disabled 时生效）
# WONDER_DEEPSEEK_TEMPERATURE=0.2          # 0–2；结构化写作建议 0.0–0.3

# 可选：Langfuse Agent Graph（绝不提交真实 key）。
# 在 Langfuse 项目 Settings → API Keys 创建；EU Cloud 默认不用填 BASE_URL。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # EU；US: https://us.cloud.langfuse.com
# 启用命令时再设置：WONDER_TRACE_EXPORTER=langfuse
# 可见 LLM/工具 I/O 仅在明确调试时设置：WONDER_TRACE_CAPTURE_CONTENT=preview 或 full

# 可选：其他数据通道
# WONDER_SEC_USER_AGENT=Your Name your-contact@example.com
# WONDER_FUTU_HOST=127.0.0.1
# WONDER_FUTU_PORT=11111

# Pi 问答运行时仍在验收；需要 Node >=22.19 并在项目 pi_runtime 目录 npm ci。
# 选择预览请在终端 export WONDER_AGENT_RUNTIME=pi（默认仍为既有 Python loop）。
