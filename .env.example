# 本地凭据与配置示例。
# 复制为项目根目录的 .env 并填入你自己的值；.env 已被 .gitignore 忽略，不会提交。
# 已存在的环境变量优先，.env 不会覆盖它们。

# DeepSeek 写作入口（write-draft）所需
DEEPSEEK_API_KEY=

# 可选：DeepSeek 参数
# WONDER_DEEPSEEK_MODEL=deepseek-flash
# WONDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# WONDER_DEEPSEEK_MAX_TOKENS=16000
# WONDER_DEEPSEEK_THINKING=disabled        # disabled/enabled；默认 disabled（temperature 仅在 disabled 时生效）
# WONDER_DEEPSEEK_TEMPERATURE=0.2          # 0–2；结构化写作建议 0.0–0.3

# 可选：其他数据通道
# WONDER_SEC_USER_AGENT=Your Name your-contact@example.com
# WONDER_FUTU_HOST=127.0.0.1
# WONDER_FUTU_PORT=11111
